# =====================================================================
# BrandOS — ключи доступа.
# Скопируйте этот файл в .env (локально) или впишите переменные в
# Railway → сервис → Variables. Файл .env НИКОГДА не выкладывайте в GitHub.
# Каждый источник включается, только если заполнен его ключ.
# Без ключа блок показывает демо-данные с пометкой «демо».
# Выпускайте токены с правами «только чтение», где это возможно.
# =====================================================================

# ---------- Вход в дашборд (обязательно на хостинге) ----------
# Пароль, который команда вводит на странице входа. Придумайте длинный.
APP_PASSWORD=
# Секрет подписи сессий (необязательно). Любая длинная случайная строка.
SESSION_SECRET=
# Папка с данными. На Railway — путь постоянного диска (Volume), например /data.
# Если диск подключён, Railway сам задаёт RAILWAY_VOLUME_MOUNT_PATH — тогда можно не заполнять.
DATA_DIR=

# ---------- Wildberries (начните с него) ----------
# 1. Личный кабинет продавца WB → Профиль → Настройки → Доступ к API.
# 2. «Создать новый токен», отметьте категории: Статистика, Аналитика, Документы, Продвижение.
# 3. Включите «Только на чтение». Скопируйте токен сюда.
WB_TOKEN=
# Отдельный токен для рекламы (необязательно — иначе используется WB_TOKEN).
WB_ADS_TOKEN=
# Отдельный токен для документов (необязательно). WB_DOCS=off — не забирать документы WB.
WB_DOCS_TOKEN=
WB_DOCS=

# ---------- Ozon Seller ----------
# 1. seller.ozon.ru → Настройки → API ключи → «Сгенерировать ключ».
# 2. Роль: «Admin read only». 3. Client-Id и API-ключ показаны на той же странице.
OZON_CLIENT_ID=
OZON_API_KEY=

# ---------- Ozon Performance (реклама Ozon) ----------
# Это ОТДЕЛЬНЫЙ кабинет: ключи Seller API не подходят.
# 1. performance.ozon.ru → Настройки → API → «Создать аккаунт».
# 2. Скопируйте client_id и client_secret.
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# ---------- CRM: amoCRM ИЛИ Битрикс24 (если заданы обе — используется amoCRM) ----------
# amoCRM: 1. Настройки → Интеграции → «Создать интеграцию» (внешняя).
#         2. Вкладка «Ключи и доступы» → «Сгенерировать долгосрочный токен».
#         3. Поддомен — часть адреса: https://ПОДДОМЕН.amocrm.ru
AMO_SUBDOMAIN=
AMO_TOKEN=
# Id воронки (необязательно — иначе главная воронка)
AMO_PIPELINE_ID=
# Битрикс24: Разработчикам → Другое → «Входящий вебхук», права: crm.
# Скопируйте адрес вида https://ПОРТАЛ.bitrix24.ru/rest/1/КОД/
BITRIX_WEBHOOK=

# ---------- Банки ----------
# Т-Банк Бизнес: интернет-банк → Интеграции → API → «Выпустить токен»,
# права: чтение счетов и выписок.
TBANK_TOKEN=
# Точка: интернет-банк → Интеграции и API → «Подключить» → JWT-токен
# с правами на чтение счетов, остатков и выписок.
TOCHKA_TOKEN=

# ---------- Почта (документы из вложений писем) ----------
# Нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не обычный пароль:
#   Яндекс: Яндекс ID → Безопасность → Пароли приложений → Почта. Сервер: imap.yandex.ru
#   Google: Аккаунт → Безопасность → Пароли приложений. Сервер: imap.gmail.com
#   Mail.ru: Безопасность → Пароли для внешних приложений. Сервер: imap.mail.ru
# В настройках ящика должен быть включён доступ по IMAP.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------- Telegram-бот (пересылайте ему документы) ----------
# 1. Напишите @BotFather → /newbot → придумайте имя → скопируйте токен.
TELEGRAM_BOT_TOKEN=
# Кому можно присылать документы: id или username через запятую (пусто — всем).
TELEGRAM_ALLOWED=

# ---------- ЭДО Диадок (экспериментально) ----------
# 1. developer.kontur.ru → получите ключ разработчика (client_id).
# 2. Логин и пароль пользователя Диадока с доступом к ящику организации.
DIADOC_API_KEY=
DIADOC_LOGIN=
DIADOC_PASSWORD=

# ---------- Claude API (платно, по объёму запросов) ----------
# console.anthropic.com → API Keys → Create Key. Пополните баланс в Billing.
# Нужен для распознавания документов, ИИ-чата и Центра решений на ИИ.
ANTHROPIC_API_KEY=
# Модель (необязательно)
ANTHROPIC_MODEL=claude-sonnet-4-5
